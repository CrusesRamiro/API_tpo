spring.application.name=demo
server.port=4002

# Supabase (PostgreSQL) - Connection Pooler IPv4
# Obtener desde: Supabase Dashboard > Settings > Database > Connection pooling (Transaction mode)
spring.datasource.url=jdbc:postgresql://TU_POOLER_HOST.pooler.supabase.com:6543/postgres?user=postgres.TU_PROJECT_REF&password=TU_PASSWORD
spring.datasource.driverClassName=org.postgresql.Driver

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
